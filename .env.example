OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PORT=3000

# Video generation: google_veo or local
VIDEO_PROVIDER=google_veo
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
# Supported Gemini API preview models: veo-3.1-generate-preview, veo-3.1-fast-generate-preview, veo-3.1-lite-generate-preview
VEO_RESOLUTION=720p
VEO_POLL_MS=10000
VEO_TIMEOUT_MS=600000

# Free Gemini models used by Safe Free Mode. Do not change these to paid models.
GEMINI_FREE_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
OUTPUT_DIR=renders

# Paid-only providers, used only when AI_VIDEO_PAID_MODE=true.
TTS_MODEL=gpt-4o-mini-tts
IMAGE_MODEL=gpt-image-2

# Cost safety: keep false to block OpenAI, paid Gemini media, Veo and paid TTS.
AI_VIDEO_PAID_MODE=false
